# Configuration de production (copier vers deploy/.env sur le serveur, jamais dans Git).

# Nom de domaine (sans www ni app) et e-mail pour les certificats HTTPS
DOMAIN=spacora.tech
ACME_EMAIL=

# Secrets : générer chacun sur le serveur avec `openssl rand -hex 32` (lettres et chiffres uniquement)
DB_PASSWORD=
AUTH_SECRET=
CRON_SECRET=

# E-mails (Brevo conseillé) : voir docs/deploiement-ovh.md, étape 7
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Spacora <no-reply@spacora.tech>

# Paiement Stripe (facultatif au lancement) : voir .env.example à la racine du projet
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ESSENTIEL_MONTH=
# STRIPE_PRICE_ESSENTIEL_YEAR=
# STRIPE_PRICE_PRO_MONTH=
# STRIPE_PRICE_PRO_YEAR=
# STRIPE_PRICE_BUSINESS_MONTH=
# STRIPE_PRICE_BUSINESS_YEAR=
