# Variables d'environnement (aucun secret dans le dépôt). Copier ce fichier vers .env.

# Base de développement (docker compose up -d) et base dédiée aux tests d'intégration
DATABASE_URL="postgresql://gestion:gestion@localhost:5432/gestion_dev"
DATABASE_URL_TEST="postgresql://gestion:gestion@localhost:5432/gestion_test"

# Base en ligne (ex. OVH Web Cloud Databases, voir docs/base-en-ligne-ovh.md) : connexion chiffrée
# DATABASE_URL="postgresql://spacora:MOTDEPASSE@HOTE:PORT/spacora?sslmode=require"
# Autorité de certification fournie par l'hébergeur (si son certificat n'est pas reconnu d'office)
# DATABASE_SSL_CA="C:/chemin/vers/ovh-ca.pem"

# Secret de signature des sessions : générer avec `openssl rand -base64 32`
AUTH_SECRET=""

# En production derrière un proxy de confiance (HTTPS) :
# AUTH_TRUST_HOST=true

# URL publique du service (obligatoire en production) et nom d'hôte autorisé pour les server actions
# AUTH_URL="https://app.spacora.tech"
# APP_ORIGIN="app.spacora.tech"

# Site vitrine sur un domaine séparé (facultatif). Avec SITE_URL ET AUTH_URL renseignés et différents :
# - www : accueil, tarifs et pages légales ; connexion, inscription et service partent sur app ;
# - app : l'accueil mène au tableau de bord (ou à la connexion).
# Les deux domaines pointent vers la même application. Sans SITE_URL, tout est servi sur un seul domaine.
# SITE_URL="https://www.spacora.tech"

# Purge nocturne via POST /api/cron/purge : secret d'au moins 32 caractères (`openssl rand -base64 32`).
# Sans cette variable, la route répond 503 ; le script `npm run purge` n'en a pas besoin.
# CRON_SECRET=""

# Abonnements (Stripe) : sans ces variables, le paiement en ligne est désactivé (essai et offres restent visibles).
# Clés du tableau de bord Stripe (mode test pour essayer). Webhook : POST https://VOTRE-DOMAINE/api/stripe/webhook
# avec les événements customer.subscription.created / updated / deleted.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Un prix Stripe (récurrent) par offre et par périodicité :
# STRIPE_PRICE_ESSENTIEL_MONTH="price_..."
# STRIPE_PRICE_ESSENTIEL_YEAR="price_..."
# STRIPE_PRICE_PRO_MONTH="price_..."
# STRIPE_PRICE_PRO_YEAR="price_..."
# STRIPE_PRICE_BUSINESS_MONTH="price_..."
# STRIPE_PRICE_BUSINESS_YEAR="price_..."

# E-mails de service (confirmation d'adresse, mot de passe oublié, invitations, fin d'essai) par SMTP.
# Prestataire conseillé : Brevo (France). Sans SMTP_HOST : en développement, les e-mails sont écrits dans
# .dev-emails/outbox.jsonl et visibles sur /dev/emails ; en production, aucun e-mail n'est envoyé et les comptes
# utilisent des mots de passe provisoires. Déclarez SPF et DKIM du domaine expéditeur chez votre prestataire.
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="Spacora <no-reply@spacora.tech>"
