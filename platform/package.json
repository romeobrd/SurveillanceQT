{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "setup": "prisma migrate deploy && prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:seed:e2e": "tsx --conditions=react-server prisma/seed-e2e.ts",
    "e2e:tools": "tsx --conditions=react-server prisma/e2e-tools.ts",
    "purge": "tsx --conditions=react-server prisma/purge.ts",
    "export:vitrine": "node scripts/export-vitrine.mjs",
    "demo:site": "node scripts/edition.mjs boutique dev",
    "db:certificat": "node scripts/certificat-base.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "10.1.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "22.6.2",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
